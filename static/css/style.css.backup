/* Medical-grade Color System */
:root {
    /* Primary Colors */
    --primary-blue: #2563EB;
    --primary-dark: #1E40AF;
    --primary-light: #3B82F6;
    
    /* Secondary Colors */
    --secondary-slate: #475569;
    --secondary-teal: #0891B2;
    
    /* Background Colors */
    --bg-main: #F7F9FB;
    --bg-surface: #FFFFFF;
    --bg-hover: #F1F5F9;
    
    /* Text Colors */
    --text-primary: #1F2937;
    --text-secondary: #6B7280;
    --text-light: #9CA3AF;
    
    /* Border & Divider */
    --border-color: #E5E7EB;
    --border-light: #F3F4F6;
    
    /* Accent Colors */
    --accent-success: #10B981;
    --accent-warning: #F59E0B;
    --accent-danger: #EF4444;
    --accent-info: #0EA5E9;
    
    /* Shadows */
    --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    
    /* Spacing */
    --radius-sm: 6px;
    --radius-md: 8px;
    --radius-lg: 12px;
    --radius-full: 50px;
}

.back-button {
    background-color: var(--text-primary);
    color: var(--bg-surface);
    padding: 10px 20px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    float: right;
    margin-left: 10px;
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
}

.back-button:hover {
    background-color: var(--secondary-slate);
    box-shadow: var(--shadow-md);
}

.next-button {
    background-color: var(--primary-blue);
    color: var(--bg-surface);
    padding: 10px 20px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    float: right;
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
}

.next-button:hover {
    background-color: var(--primary-dark);
    box-shadow: var(--shadow-md);
}

* {
    background: var(--bg-main);
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
}

nav {
    height: 80px;
    background: var(--primary-blue);
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0rem calc((100vw - 1300px) / 2);
    z-index: 1000;
    box-shadow: var(--shadow-sm);
}

nav .logo {
    color: var(--bg-surface);
    font-size: 1.5rem;
    font-weight: bold;
    font-style: italic;
    padding: 0 2rem;
    background: transparent;
}

nav .nav-items {
    display: flex;
    gap: 1rem;
}

nav a {
    font-size: 1.1rem;
    text-decoration: none;
    color: var(--bg-surface);
    padding: 0 1.5rem;
    font-weight: 500;
    background: transparent;
    transition: all 0.2s ease;
}

nav a:hover {
    color: var(--bg-main);
    text-decoration: underline;
    text-underline-offset: 0.5rem;
    background: transparent;
}

.background-image {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
}

.hero {
    background: transparent;
    position: relative;
}

.hero-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    height: 95vh;
    padding: 3rem calc((100vw - 1300px) / 2);
    z-index: 1; /* Ensures content is above background image */
}

.column-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    color: var(--text-primary);
    padding: 0rem 2rem;
    background: transparent;
}

.column-right {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 0rem 2rem;
}

.column-left h1 {
    margin-bottom: 1rem;
    font-size: 3rem;
    background: transparent;
    color: var(--text-primary);
}

.column-left p {
    margin-bottom: 2rem;
    font-size: 1.5rem;
    line-height: 1.5;
    background: transparent;
    color: var(--text-secondary);
}

button {
    padding: 1rem 3rem;
    font-size: 1rem;
    border: none;
    color: #fff;
    background: #000;
    cursor: pointer;
    border-radius: 50px;
}

button a {
    font-size: 1rem;
    color: var(--bg-surface);
    background: transparent;
    text-decoration: none;
}

button:hover {
    background: var(--primary-dark);
    color: var(--bg-surface);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
}

.hero-image {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    background: transparent;
}

@media screen and (max-width: 768px) {
    .hero-container {
        grid-template-columns: 1fr;
    }
}

form input[type="file"] {
    padding: 1rem 2rem;
    padding-right: 0;
    font-size: 1rem;
    border: 2px solid var(--border-color);
    color: var(--text-primary);
    background: var(--bg-surface);
    cursor: pointer;
    border-radius: var(--radius-full);
    margin-right: 1rem;
    transition: all 0.2s ease;
}

form input[type="submit"] {
    padding: 1rem 3rem;
    font-size: 1rem;
    border: none;
    color: var(--bg-surface);
    background: var(--primary-blue);
    cursor: pointer;
    border-radius: var(--radius-full);
    font-weight: 600;
    transition: all 0.2s ease;
}

form input[type="file"]:hover {
    border-color: var(--primary-blue);
    box-shadow: var(--shadow-sm);
}

form input[type="submit"]:hover {
    background: var(--primary-dark);
    color: var(--bg-surface);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
}

.img-preview {
    width: 256px;
    height: 256px;
    position: relative;
    border: 3px solid var(--border-color);
    box-shadow: var(--shadow-md);
    margin-top: 1em;
    margin-bottom: 1em;
    border-radius: var(--radius-md);
    background: var(--bg-surface);
}

.img-preview > div {
    width: 100%;
    height: 100%;
    background-size: 256px 256px;
    background-repeat: no-repeat;
    background-position: center;
}

.form-submit-button {
    padding: 1rem 3rem;
    font-size: 1rem;
    border: none;
    color: var(--bg-surface);
    background: var(--primary-blue);
    cursor: pointer;
    border-radius: var(--radius-full);
    font-weight: 600;
    transition: all 0.2s ease;
}

.form-submit-button:hover {
    background: var(--primary-dark);
    color: var(--bg-surface);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
}