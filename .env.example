# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET
DB_HOST=localhost
DB_USER=colon_app
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DB_NAME=colon_disease_db
# False is allowed ONLY when testing locally over plain HTTP.
COOKIE_SECURE=true
# Only enable on isolated local demos. Never use for real doctor provisioning.
WCE_ALLOW_SELF_SIGNUP=false
PORT=5000
